{
  "name": "chicochat",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,cyan \"npm run dev -w @chicochat/api\" \"npm run dev -w @chicochat/web\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @chicochat/api",
    "db:migrate": "npm run db:migrate -w @chicochat/api",
    "db:seed": "npm run db:seed -w @chicochat/api",
    "admin:grant": "npm run admin:grant -w @chicochat/api --",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
