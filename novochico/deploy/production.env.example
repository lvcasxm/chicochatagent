# Modelo do arquivo de ambiente da produção. Copie para deploy/production.env e preencha.
# Esse arquivo NUNCA é versionado (.gitignore) e nunca vai para a imagem (.dockerignore).
# Os valores de exemplo abaixo são fictícios.

# --- Banco (dentro da rede do Compose, o servidor se chama "db") ---
POSTGRES_USER=chico
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=chicochat
DATABASE_URL=postgres://chico:troque-por-uma-senha-forte@db:5432/chicochat

# --- Endereço e sessão ---
# Endereço pelo qual o navegador acessa o sistema (https, sem barra final).
APP_PUBLIC_URL=https://chicochat.example.test
# Pelo menos 32 caracteres aleatórios. Trocar derruba as sessões abertas.
SESSION_SECRET=
# Obrigatório atrás do proxy reverso: sem isso o limite por IP enxerga só o IP do proxy.
TRUST_PROXY=true
ALLOWED_EMAIL_DOMAINS=

# --- Google (login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=

# --- IA (Gemini) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=

# --- GLPI ---
GLPI_PROVIDER=glpi
GLPI_URL=
GLPI_TOKEN_PATH=/api.php/token
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_PORTAL_URL=

# --- Opcionais ---
# APP_PORT=3000
# CHICOCHAT_TAG=1.0.0
# LOG_LEVEL=info
