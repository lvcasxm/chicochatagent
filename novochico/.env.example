# Copie para .env (ignorado pelo Git). Todos os valores abaixo são fictícios,
# só para desenvolvimento local. Nunca coloque segredos reais neste arquivo.

# API
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info

# Só use `true` atrás de um proxy reverso confiável (o IP do cliente vem do proxy).
# Sem isso, em produção, todos pareceriam ter o mesmo IP e dividiriam o limite de requisições.
# TRUST_PROXY=false

# Endereço pelo qual o navegador acessa o sistema, sem caminho. No desenvolvimento é o do Vite.
# Define o Origin aceito nas escritas e o endereço de volta do login. Em produção: https.
APP_PUBLIC_URL=http://127.0.0.1:5173

# Assina o cookie temporário do login. Use um valor aleatório e secreto, com 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# O valor abaixo é só um exemplo e é recusado em produção.
SESSION_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres

# Só e-mails desses domínios entram, separados por vírgula.
ALLOWED_EMAIL_DOMAINS=pedroleopoldo.mg.gov.br

# Login com Google. Crie um cliente OAuth do tipo "Aplicativo da Web" no Google Cloud e
# cadastre este endereço de redirecionamento (troque pelo seu APP_PUBLIC_URL):
#   http://127.0.0.1:5173/api/auth/google/callback
# Sem essas variáveis o login fica indisponível. Nunca coloque os valores reais neste arquivo.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_HOSTED_DOMAIN=pedroleopoldo.mg.gov.br

# PostgreSQL de desenvolvimento (npm run db:up)
DB_PORT=5433
POSTGRES_USER=chico
POSTGRES_PASSWORD=chico_dev_only
POSTGRES_DB=chicochat
DATABASE_URL=postgres://chico:chico_dev_only@127.0.0.1:5433/chicochat

# Usuário que altera o schema, só para `npm run db:migrate`. Em desenvolvimento pode
# ficar vazio: cai para DATABASE_URL. Em produção, use um usuário separado.
# DATABASE_MIGRATION_URL=

# Testes de integração (banco separado, criado pelo Compose). Cada arquivo de teste cria
# e apaga seu próprio banco a partir deste; o nome precisa terminar em _test.
TEST_DATABASE_URL=postgres://chico:chico_dev_only@127.0.0.1:5433/chicochat_test

# IA do chat. 'fake' responde com um roteiro, só para desenvolver a interface sem chave.
# Para usar o Gemini de verdade: AI_PROVIDER=gemini e GEMINI_API_KEY (só neste .env local).
AI_PROVIDER=fake
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# CHAT_CACHE_ENABLED=true

# Portal de chamados do GLPI, oferecido quando a IA está fora do ar e na tela inicial.
# GLPI_PORTAL_URL=

# GLPI. 'fake' simula a abertura de chamados, só para desenvolver (recusado em produção).
# Para o GLPI de verdade: GLPI_PROVIDER=glpi e as variáveis abaixo, só neste .env local.
GLPI_PROVIDER=fake
# GLPI_URL=
# GLPI_TOKEN_PATH=/api.php/token
# GLPI_CLIENT_ID=
# GLPI_CLIENT_SECRET=
# GLPI_USERNAME=
# GLPI_PASSWORD=
# GLPI_REQUEST_TYPE_ID=10
# GLPI_TIMEOUT_MS=15000
# TICKET_IP_REGEX=
# GEMINI_SUMMARY_MODEL=gemini-3.1-flash-lite
